# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only, never exposed to the client. Used by the cron
# ingest route and other server-side jobs that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Graph app-only credentials for scripts/auto-ingest-onehome.ts
# (Entra ID app registration, application-level Mail.Read, admin-consented —
# see README's "Automated OneHome ingest" section for setup steps).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The mailbox that receives the daily OneHome saved-search emails.
ONEHOME_MAILBOX=
